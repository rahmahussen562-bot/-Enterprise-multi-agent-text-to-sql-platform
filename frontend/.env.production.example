VITE_API_BASE_URL=https://api.sentinelsql.internal/api/v1
VITE_WS_BASE_URL=wss://api.sentinelsql.internal/api/v1
VITE_ENABLE_VOICE_INPUT=false
SENTINEL_PRODUCTION_BUILD=1
# .internal requires private DNS/WARP and trusted TLS. Public buyers need a public API hostname.
# VITE values are public build-time configuration. Never place secrets here.
