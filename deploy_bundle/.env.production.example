# Copy to a PRIVATE .env.production; no credentials belong in this file.
# Windows Docker Desktop must use Linux containers and a disk image on D:.
FASTAPI_IMAGE=ghcr.io/rahmahussen562-bot/sentinelsql-api@sha256:REPLACE_WITH_RELEASE_DIGEST
POSTGRES_IMAGE=postgres:17.11-bookworm@sha256:3645570cccdfa447589da9f57dd740faa29b30938e861289a5574b6ca6b03826
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.10.0@sha256:9b49eed8f62806d5d45ddf59ecefb5710429598ea6d3fcccd2af938f621b2b07
FRONTEND_ORIGIN=https://sentinelsql-portal.pages.dev
API_ORIGIN=https://api.sentinelsql.internal
API_HOSTNAME=api.sentinelsql.internal
# Replace the optional private ingress tag with an approved immutable digest.
PRIVATE_INGRESS_IMAGE=nginxinc/nginx-unprivileged:stable-alpine
COMPOSE_PROFILES=edge,private
# .internal requires private routing, WARP, and an institution-trusted TLS origin.
# For public browsers, replace API_ORIGIN with a hostname in your Cloudflare zone.
VITE_API_BASE_URL=https://api.sentinelsql.internal/api/v1
VITE_WS_BASE_URL=wss://api.sentinelsql.internal/api/v1
DATA_ROOT=D:/BIRD-Interact/deploy_bundle/.runtime/production/data
SECRETS_DIR=D:/BIRD-Interact/deploy_bundle/.runtime/production/secrets
# On Linux, use /srv/sentinelsql/data and /srv/sentinelsql/secrets respectively.
POSTGRES_DB=fincore
POSTGRES_ADMIN_USER=sentinel_admin
API_WORKERS=4
JOB_TIMEOUT_SECONDS=60
SESSION_TTL_SECONDS=900
# GitHub Secrets: CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID, TUNNEL_TOKEN.
# Private files: session.key, accounts.json, postgres-identities.json,
# postgres-password, postgres-ca.crt, postgres-server.crt, postgres-server.key,
# tunnel-token. Never echo them or include them in build contexts.
