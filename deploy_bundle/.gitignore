# =============================================================================
# Git Ignore Rules for Enterprise Deployment Bundle
# =============================================================================

# Production Credentials & Environment Files
.env
.env.*
!.env.example
!.env.production.example
secrets/
SECRETS_DIR/
*.pem
*.key
*.crt
edge/node_modules/

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Local Database Stores & Data Dumps
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm
pgdata/
postgres-data/
data/*
!data/fincore_schema.sql
!data/financial_metrics.v1.json
data/*.db
data/semantic_store/

# Exported Data Artifacts
*.csv
*.xlsx
query_results.*

# IDE & Operating System Files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Logs & Temporary Files
*.log
tmp/
temp/

# D-drive provisioning and build artifacts
.runtime/
build/
frontend/node_modules/
frontend/dist/
frontend/.next/
