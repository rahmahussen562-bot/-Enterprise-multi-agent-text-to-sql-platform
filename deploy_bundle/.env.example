# =============================================================================
# ENTERPRISE TEXT-TO-SQL PLATFORM - PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to '.env' and provide your target Microsoft SQL Server credentials.
# All settings can be provided as individual variables or via a full connection string.

# -----------------------------------------------------------------------------
# Microsoft SQL Server (T-SQL) Primary Parameters
# -----------------------------------------------------------------------------
# Host / Server name or instance (e.g. localhost\SQLEXPRESS, 10.0.0.5,1433, or myserver.database.windows.net)
MSSQL_SERVER=localhost\SQLEXPRESS

# Target database name
MSSQL_DATABASE=Chinook

# Authentication mode:
# Set to 'yes' / 'true' for Windows Integrated Authentication (Active Directory / Windows Account)
# Set to 'no' / 'false' for SQL Server Authentication (requires MSSQL_USER and MSSQL_PASSWORD)
MSSQL_TRUSTED_CONNECTION=yes

# SQL Server Authentication credentials (used if MSSQL_TRUSTED_CONNECTION=no)
MSSQL_USER=sa
MSSQL_PASSWORD=YourStrongPasswordHere!

# Preferred ODBC Driver:
# Leave blank to enable automated host discovery in order of priority:
# 1. ODBC Driver 18 for SQL Server
# 2. ODBC Driver 17 for SQL Server
# 3. SQL Server Native Client 11.0
# 4. SQL Server
MSSQL_DRIVER=

# SSL / TLS Encryption & Certificate Validation:
# TrustServerCertificate: Set to 'yes' for self-signed certificates on local development / staging
MSSQL_TRUST_SERVER_CERTIFICATE=yes
# Encrypt: 'yes', 'no', or 'optional' (recommended 'optional' for local SQL Express, 'yes' for Azure SQL)
MSSQL_ENCRYPT=optional

# Connection & Query Timeout thresholds (seconds)
MSSQL_TIMEOUT=10
MSSQL_QUERY_TIMEOUT=15

# -----------------------------------------------------------------------------
# Optional Direct Connection String Override
# -----------------------------------------------------------------------------
# If specified, overrides individual MSSQL_* parameters above.
# MSSQL_CONNECTION_STRING=DRIVER={ODBC Driver 18 for SQL Server};SERVER=tcp:sqlserver.company.internal,1433;DATABASE=Chinook;UID=sqluser;PWD=SecretPass123!;Encrypt=yes;TrustServerCertificate=no;

# -----------------------------------------------------------------------------
# Explicit Local Demo Storage
# -----------------------------------------------------------------------------
# Production never falls back automatically. Set SENTINEL_DEMO_MODE=1 only for local evaluation.
SENTINEL_DEMO_MODE=0
SQLITE_PATH=data/chinook.db

# FastAPI session policy (keys and hashed accounts are provisioned privately on D:).
SENTINEL_SESSION_TTL=900
SENTINEL_API_WORKERS=4
SENTINEL_JOB_TIMEOUT=60
SENTINEL_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# SENTINEL_AUTH_FILE=D:/BIRD-Interact/deploy_bundle/.runtime/api-private/accounts.json
# SENTINEL_API_STATE=D:/BIRD-Interact/deploy_bundle/.runtime/api-private/jobs.sqlite
# Supply SENTINEL_SESSION_KEY through a secret manager, or use the private session.key file.

# FinCore banking personas use individual PostgreSQL LOGINs and private identity maps.
# All remote conninfo entries require sslmode=verify-full; never use migration credentials for analytics.
# SENTINEL_PG_AUTH_FILE=D:/BIRD-Interact/deploy_bundle/.runtime/api-private/postgres-identities.json
# SENTINEL_PG_MIGRATION_DSN_FILE=D:/BIRD-Interact/deploy_bundle/.runtime/api-private/migration.conninfo
# See docs/FINCORE_SCHEMA.md for fresh PostgreSQL 17+ provisioning and branch/case ACLs.

# -----------------------------------------------------------------------------
# LLM & Vector Store Parameters (Optional)
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# CHROMA_PERSIST_DIR=data/chroma
