  "components": {
    "schemas": {
      "AuditResponse": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "running",
              "completed",
              "failed",
              "cancelled",
              "interrupted"
            ],
            "title": "Status"
          },
          "events": {
            "items": {
              "$ref": "#/components/schemas/TraceEvent"
            },
            "type": "array",
            "title": "Events"
          },
          "next_sequence": {
            "type": "integer",
            "title": "Next Sequence"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "job_id",
          "status",
          "events",
          "next_sequence"
        ],
        "title": "AuditResponse"
      },
      "ClassifyResponse": {
        "properties": {
          "intent": {
            "type": "string",
            "enum": [
              "HELP",
              "DATA_QUERY",
              "OUT_OF_SCOPE",
              "SECURITY_ATTACK"
            ],
            "title": "Intent"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence"
          },
          "response": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Response"
          },
          "sample_queries": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Sample Queries"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "intent",
          "confidence"
        ],
        "title": "ClassifyResponse"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          },
          "error_code": {
            "type": "string",
            "title": "Error Code"
          },
          "ast_trace": {
            "items": {
              "$ref": "#/components/schemas/TraceEvent"
            },
            "type": "array",
            "title": "Ast Trace"
          },
          "job_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Job Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "detail",
          "error_code"
        ],
        "title": "ErrorResponse"
      },
      "JobResponse": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "running",
              "completed",
              "failed",
              "cancelled",
              "interrupted"
            ],
            "title": "Status"
          },
          "output": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/QueryOutput"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorResponse"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "job_id",
          "status"
        ],
        "title": "JobResponse"
      },
      "LoginRequest": {
        "properties": {
          "user_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "User Id"
          },
          "password": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 1,
            "format": "password",
            "title": "Password",
            "writeOnly": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "user_id",
          "password"
        ],
        "title": "LoginRequest"
      },
      "LoginResponse": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
            "const": "bearer",
            "title": "Token Type",
            "default": "bearer"
          },
          "session": {
            "$ref": "#/components/schemas/SessionClaims"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "access_token",
          "session"
        ],
        "title": "LoginResponse"
      },
      "QueryOutput": {
        "properties": {
          "final_sql": {
            "type": "string",
            "title": "Final Sql"
          },
          "columns": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Columns"
          },
          "rows": {
            "items": {
              "items": {},
              "type": "array"
            },
            "type": "array",
            "title": "Rows"
          },
          "row_count": {
            "type": "integer",
            "title": "Row Count"
          },
          "executive_narrative": {
            "type": "string",
            "title": "Executive Narrative"
          },
          "execution_time_ms": {
            "type": "number",
            "title": "Execution Time Ms"
          },
          "intent": {
            "type": "string",
            "enum": [
              "HELP",
              "DATA_QUERY",
              "OUT_OF_SCOPE",
              "SECURITY_ATTACK"
            ],
            "title": "Intent"
          },
          "retries": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Retries"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "final_sql",
          "columns",
          "rows",
          "row_count",
          "executive_narrative",
          "execution_time_ms",
          "intent"
